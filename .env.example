# Copy to .env and fill in values. .env is git-ignored.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://localhost:5432/devmark

# IANA timezone for day boundaries, e.g. Asia/Karachi
TIMEZONE=UTC

# --- Account credentials (optional, can also be set from the dashboard sidebar) ---

# GitHub fine-grained token with read-only Contents and Pull requests
GITHUB_TOKEN=
GITHUB_USERNAME=

# LeetCode username (leetcode.com/u/<username>/)
LEETCODE_USERNAME=

# Todoist API token (Settings → Integrations → Developer)
TODOIST_API_TOKEN=

# Claude Code session logs. Defaults to ~/.claude/projects
# CLAUDE_PROJECTS_DIR=

# Use mock data instead of live APIs
USE_MOCK_DATA=false
