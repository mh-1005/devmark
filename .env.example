# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL connection string. Local Homebrew Postgres needs no password.
DATABASE_URL=postgresql+psycopg://localhost:5432/digital_life

# true = every connector returns fake data instead of calling its API.
# For a quick demo prefer: uv run python -m scripts.seed_mock
USE_MOCK_DATA=false

# --- Connector credentials (added as each connector is built) ---
# GitHub: fine-grained token, read-only Contents + Pull requests
GITHUB_TOKEN=
GITHUB_USERNAME=

# LeetCode: public profile username (leetcode.com/u/<username>/), no token needed
LEETCODE_USERNAME=

# Todoist: Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# Claude Code: local session logs. Default is ~/.claude/projects; override only if yours live elsewhere.
# CLAUDE_PROJECTS_DIR=

# Timezone for day boundaries and timeline display (IANA name)
TIMEZONE=UTC
